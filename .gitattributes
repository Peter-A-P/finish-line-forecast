# The golden fixtures are fixed-width text whose column positions are the thing under
# test. Checking them out with translated line endings has never broken the parser, which
# splits on both, but pinning them costs nothing and removes the question.
tests/fixtures/*.html text eol=lf

# Everything else is ordinary source; let git normalise it in the repository and give each
# machine its own endings in the working tree.
* text=auto

# ⚠️ Except prediction files, which are never touched. Their SHA-256 is published before the
# gun, and a checkout that turned LF into CRLF would hand every Windows reader a file that no
# longer matches its own published hash. After `* text=auto`, because the last match wins.
predictions/*.json -text
